# novel-harness 配置
# 复制为 .env 并修改

# RAG 服务
RAG_HOST=0.0.0.0
RAG_PORT=3456
RAG_LOG_LEVEL=INFO

# 远程知识包市场
NOVEL_HARNESS_REMOTE_MANIFEST=http://47.103.57.247:9000/manifest

# 向量嵌入模型 (sentence-transformers)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# 重排序模型 (CrossEncoder)
RERANKER_MODEL=cross-encoder/stsb-distilroberta-base

# 检索参数
RETRIEVE_TOP_K=5
RETRIEVE_FTS_N=30
RETRIEVE_VEC_N=30
RETRIEVE_BM25_N=30
