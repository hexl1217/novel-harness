# novel-harness 配置
# 复制为 .env 并修改

# RAG 服务
RAG_HOST=0.0.0.0
RAG_PORT=3456
RAG_LOG_LEVEL=INFO

# 远程知识包市场（可选，未配置时仅使用内置知识包）
# 填自建或团队内部的 manifest 地址，例如 https://example.com/manifest
NOVEL_HARNESS_REMOTE_MANIFEST=

# 向量嵌入模型 (sentence-transformers)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# 重排序模型 (CrossEncoder)
RERANKER_MODEL=cross-encoder/stsb-distilroberta-base

# 检索参数
RETRIEVE_TOP_K=5
RETRIEVE_FTS_N=30
RETRIEVE_VEC_N=30
RETRIEVE_BM25_N=30
